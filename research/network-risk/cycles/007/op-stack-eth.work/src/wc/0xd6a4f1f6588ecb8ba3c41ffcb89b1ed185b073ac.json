tability":"view","type":"function"},{"inputs":[],"name":"name","outputs":[{"internalType":"string","name":"","type":"string"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"symbol","outputs":[{"internalType":"string","name":"","type":"string"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"totalSupply","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"recipient","type":"address"},{"internalType":"uint256","name":"amount","type":"uint256"}],"name":"transfer","outputs":[{"internalType":"bool","name":"","type":"bool"}],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"sender","type":"address"},{"internalType":"address","name":"recipient","type":"address"},{"internalType":"uint256","name":"amount","type":"uint256"}],"name":"transferFrom","outputs":[{"internalType":"bool","name":"","type":"bool"}],"stateMutability":"nonpayable","type":"function"}],"conflicting_implementations":null,"certified":false,"additional_sources":[],"is_verified_via_sourcify":false,"can_be_visualized_via_sol2uml":true,"evm_version":"default","language":"solidity","is_verified_via_eth_bytecode_db":false,"is_fully_verified":false,"license_type":"none","is_blueprint":false,"name":"MUPPETS","creation_bytecode":"","external_libraries":[],"proxy_type":null,"implementations":[],"verified_at":"2025-03-30T05:58:39.732725Z","is_verified_via_verifier_alliance":false,"compiler_version":"v0.8.26+commit.8a97fa7a","decoded_constructor_args":null,"sourcify_repo_url":null,"optimization_runs":null,"compiler_settings":null,"is_verified":true,"verified_twin_address_hash":null,"optimization_enabled":false,"deployed_bytecode":"","source_code":"// SPDX-License-Identifier: MIT\npragma solidity ^0.8.0;\n\ninterface IERC20 {\n    function totalSupply() external view returns (uint256);\n    function balanceOf(address account) external view returns (uint256);\n    function transfer(address recipient, uint256 amount) external returns (bool);\n    function allowance(address owner, address spender) external view returns (uint256);\n    function approve(address spender, uint256 amount) external returns (bool);\n    function transferFrom(address sender, address recipient, uint256 amount) external returns (bool);\n    \n    event Transfer(address indexed from, address indexed to, uint256 value);\n    event Approval(address indexed owner, address indexed spender, uint256 value);\n}\n\ncontract MUPPETS is IERC20 {\n    string public constant name = \"MUPPETS\";\n    string public constant symbol = \"MUPPETS\";\n    uint8 public constant decimals = 18;\n    uint256 private _totalSupply = 1000000000 * 10**uint256(decimals);\n\n    mapping(address => uint256) private _balances;\n    mapping(address => mapping(address => uint256)) private _allowances;\n    mapping(address => bool) private _excludedFromDividends;\n\n    uint256 public dividendPool;\n    uint256 public constant DIVIDEND_PERCENTAGE = 1;\n\n    address[] private holders;\n    mapping(address => bool) private isHolder;\n\n    event DividendsDistributed(uint256 amount);\n\n    constructor() {\n        _balances[msg.sender] = _totalSupply;\n        emit Transfer(address(0), msg.sender, _totalSupply);\n    }\n\n    function totalSupply() public view override returns (uint256) {\n        return _totalSupply;\n    }\n\n    function balanceOf(address account) public view override returns (uint256) {\n        return _balances[account];\n    }\n\n    function transfer(address recipient, uint256 amount) public override returns (bool) {\n        require(recipient != address(0), \"MUPPETS: transfer to the zero address\");\n        require(_balances[msg.sender] >= amount, \"MUPPETS: insufficient balance\");\n\n        uint256 dividendFee = (amount * DIVIDEND_PERCENTAGE) / 100;\n        uint256 amountAfterFee = amount - dividendFee;\n\n        _balances[msg.sender] -= amount;\n        _balances[recipient] += amountAfterFee;\n        dividendPool += dividendFee;\n\n        emit Transfer(msg.sender, recipient, amountAfterFee);\n\n        if (!isHolder[recipient]) {\n            holders.push(recipient);\n            isHolder[recipient] = true;\n        }\n\n        distributeDividends();\n        return true;\n    }\n\n    function allowance(address owner, address spender) public view override returns (uint256) {\n        return _allowances[owner][spender];\n    }\n\n    function approve(address spender, uint256 amount) public override returns (bool) {\n        require(spender != address(0), \"MUPPETS: approve to the zero address\");\n        _allowances[msg.sender][spender] = amount;\n        emit Approval(msg.sender, spender, amount);\n        return true;\n    }\n\n    function transferFrom(address sender, address recipient, uint256 amount) public override returns (bool) {\n        require(sender != address(0), \"MUPPETS: transfer from the zero address\");\n        require(recipient != address(0), \"MUPPETS: transfer to the zero address\");\n        require(_balances[sender] >= amount, \"MUPPETS: insufficient balance\");\n        require(_allowances[sender][msg.sender] >= amount, \"MUPPETS: transfer amount exceeds allowance\");\n\n        uint256 dividendFee = (amount * DIVIDEND_PERCENTAGE) / 100;\n        uint256 amountAfterFee = amount - dividendFee;\n\n        _balances[sender] -= amount;\n        _balances[recipient] += amountAfterFee;\n        _allowances[sender][msg.sender] -= amount;\n        dividendPool += dividendFee;\n\n        emit Transfer(sender, recipient, amountAfterFee);\n\n        if (!isHolder[recipient]) {\n            holders.push(recipient);\n            isHolder[recipient] = true;\n        }\n\n        distributeDividends();\n        return true;\n    }\n\n    function distributeDividends() private {\n        if (dividendPool == 0) return;\n\n        uint256 totalEligibleBalance = 0;\n        for (uint256 i = 0; i < holders.length; i++) {\n            if (!_excludedFromDividends[holders[i]]) {\n                totalEligibleBalance += _balances[holders[i]];\n            }\n        }\n\n        if (totalEligibleBalance == 0) return;\n\n        for (uint256 i = 0; i < holders.length; i++) {\n            address holder = holders[i];\n            if (_excludedFromDividends[holder]) continue;\n\n            uint256 share = (_balances[holder] * dividendPool) / totalEligibleBalance;\n            if (share > 0) {\n                _balances[holder] += share;\n                emit Transfer(address(this), holder, share);\n            }\n        }\n\n        dividendPool = 0;\n        emit DividendsDistributed(dividendPool);\n    }\n}\n","creation_status":"success","file_path":null}