// Variant of Driver.sol for the Monad harness of cycle 23: token doubles there are the harness's own ERC20 without mint,
// so the driver is pre-funded and transfers instead of minting. Generated by text substitution.
// SPDX-License-Identifier: UNLICENSED
// Read-only driver for theme-unexecuted-sides (cycle 25). It runs only inside eth_call with state overrides
// (or the Python reference EVM). It places no funds anywhere real: the two currencies of every case are token
// doubles whose code is put at chosen addresses by override, and the driver mints them at will.
pragma solidity 0.8.26;

struct PoolKey {
    address currency0;
    address currency1;
    uint24 fee;
    int24 tickSpacing;
    address hooks;
}

struct MLP {
    int24 tickLower;
    int24 tickUpper;
    int256 liquidityDelta;
    bytes32 salt;
}

struct SP {
    bool zeroForOne;
    int256 amountSpecified;
    uint160 sqrtPriceLimitX96;
}

struct C {
    uint256 kind; // 0 swap, 1 donate, 2 clear, 3 settleFor, 4 erc6909, 5 swap in a dynamic fee pool whose hook is this driver
    address t0;
    address t1;
    uint24 fee;
    int24 ts;
    address hooks;
    uint160 sqrtP;
    int24 tl;
    int24 tu;
    uint256 liq;
    bool zfo;
    int256 amt;
    uint160 lim;
    uint256[] p;
}

interface IPM {
    function unlock(bytes calldata) external returns (bytes memory);
    function initialize(PoolKey memory, uint160) external returns (int24);
    function modifyLiquidity(PoolKey memory, MLP memory, bytes calldata) external returns (int256, int256);
    function swap(PoolKey memory, SP memory, bytes calldata) external returns (int256);
    function donate(PoolKey memory, uint256, uint256, bytes calldata) external returns (int256);
    function sync(address) external;
    function take(address, address, uint256) external;
    function settle() external payable returns (uint256);
    function settleFor(address) external payable returns (uint256);
    function clear(address, uint256) external;
    function mint(address, uint256, uint256) external;
    function burn(address, uint256, uint256) external;
    function transfer(address, uint256, uint256) external returns (bool);
    function transferFrom(address, address, uint256, uint256) external returns (bool);
    function approve(address, uint256, uint256) external returns (bool);
    function setOperator(address, bool) external returns (bool);
    function balanceOf(address, uint256) external view returns (uint256);
    function allowance(address, address, uint256) external view returns (uint256);
    function isOperator(address, address) external view returns (bool);
    function extsload(bytes32) external view returns (bytes32);
    function exttload(bytes32) external view returns (bytes32);
    function updateDynamicLPFee(PoolKey memory, uint24) external;
}

interface ITok {
    function transfer(address, uint256) external returns (bool);
    function mint(address, uint256) external;
    function balanceOf(address) external view returns (uint256);
}

/// Token double. Its code sits at one implementation address; every currency address holds a forwarder that
/// delegatecalls here, so each currency has its own balances.
contract Tok {
    mapping(address => uint256) public balanceOf;

    function mint(address to, uint256 a) external {
        balanceOf[to] += a;
    }

    function transfer(address to, uint256 a) external returns (bool) {
        balanceOf[msg.sender] -= a;
        balanceOf[to] += a;
        return true;
    }

    function transferFrom(address f, address to, uint256 a) external returns (bool) {
        balanceOf[f] -= a;
        balanceOf[to] += a;
        return true;
    }
}

contract Driver {
    IPM constant PM = IPM(0xA11Ce5A11Ce5a11ce5A11cE5a11CE5A11CE5A11c); // replaced in the bytecode per network
    address constant S = 0x0000000000000000000000000000000055550000; // second actor, same code
    address constant B = 0x0000000000000000000000000000000000000B0b; // plain receiver
    address constant R = 0x0000000000000000000000000000000000000C0C; // plain receiver

    struct Rec {
        uint256[] w;
        uint256 n;
    }

    function _push(Rec memory r, uint256 v) internal pure {
        r.w[r.n++] = v;
    }

    function _call(Rec memory r, address to, bytes memory data) internal returns (bool ok, bytes memory ret) {
        (ok, ret) = to.call(data);
        uint256 w0;
        uint256 w1;
        if (ret.length >= 32) {
            assembly {
                w0 := mload(add(ret, 32))
            }
        } else if (ret.length >= 4) {
            assembly {
                w0 := and(mload(add(ret, 32)), shl(224, 0xffffffff))
            }
        }
        if (ret.length >= 64) {
            assembly {
                w1 := mload(add(ret, 64))
            }
        }
        _push(r, ok ? 1 : 0);
        _push(r, w0);
        _push(r, w1);
    }

    function _slot(address target, address cur) internal pure returns (bytes32) {
        return keccak256(abi.encode(target, cur));
    }

    function _delta(address target, address cur) internal view returns (int256) {
        return int256(uint256(PM.exttload(_slot(target, cur))));
    }

    function _pay(address cur, uint256 a) internal {
        while (a > 0) {
            uint256 k = a > uint256(uint128(type(int128).max)) ? uint256(uint128(type(int128).max)) : a;
            PM.sync(cur);
            ITok(cur).transfer(address(PM), k);
            PM.settle();
            a -= k;
        }
    }

    function _takeAll(address cur, address to, uint256 a) internal {
        while (a > 0) {
            uint256 k = a > uint256(uint128(type(int128).max)) ? uint256(uint128(type(int128).max)) : a;
            PM.take(cur, to, k);
            a -= k;
        }
    }

    function _settle(address cur) internal {
        int256 d = _delta(address(this), cur);
        if (d < 0) _pay(cur, uint256(-d));
        else if (d > 0) _takeAll(cur, address(this), uint256(d));
    }

    function _poolSlot(PoolKey memory key) internal pure returns (bytes32) {
        return keccak256(abi.encodePacked(keccak256(abi.encode(key)), bytes32(uint256(6))));
    }

    function _snap(Rec memory r, PoolKey memory key) internal view {
        _push(r, uint256(_delta(address(this), key.currency0)));
        _push(r, uint256(_delta(address(this), key.currency1)));
        bytes32 ps = _poolSlot(key);
        for (uint256 i = 0; i < 4; i++) {
            _push(r, uint256(PM.extsload(bytes32(uint256(ps) + i))));
        }
    }

    function _balances(Rec memory r, address t0, address t1) internal view {
        _push(r, ITok(t0).balanceOf(address(PM)));
        _push(r, ITok(t1).balanceOf(address(PM)));
        _push(r, ITok(t0).balanceOf(address(this)));
        _push(r, ITok(t1).balanceOf(address(this)));
    }

    function exec(address to, bytes calldata data) external returns (bytes memory) {
        (bool ok, bytes memory ret) = to.call(data);
        if (!ok) {
            assembly {
                revert(add(ret, 32), mload(ret))
            }
        }
        return ret;
    }

    function run(bytes[] calldata cases) external returns (bytes[] memory out) {
        out = new bytes[](cases.length);
        for (uint256 i = 0; i < cases.length; i++) {
            (bool ok, bytes memory ret) = address(PM).call(abi.encodeCall(IPM.unlock, (cases[i])));
            out[i] = abi.encode(ok, ret);
        }
    }

    function unlockCallback(bytes calldata data) external returns (bytes memory) {
        require(msg.sender == address(PM));
        C memory c = abi.decode(data, (C));
        Rec memory r = Rec(new uint256[](96), 0);
        PoolKey memory key = PoolKey(c.t0, c.t1, c.fee, c.ts, c.hooks);
        if (c.kind == 0 || c.kind == 1 || c.kind == 5) {
            (bool ok,) = _call(r, address(PM), abi.encodeCall(IPM.initialize, (key, c.sqrtP)));
            if (ok && c.liq > 0) {
                (ok,) = _call(
                    r, address(PM), abi.encodeCall(IPM.modifyLiquidity, (key, MLP(c.tl, c.tu, int256(c.liq), 0), ""))
                );
            } else {
                _push(r, 2);
                _push(r, 0);
                _push(r, 0);
            }
            if (c.kind == 5) {
                _call(r, address(PM), abi.encodeCall(IPM.updateDynamicLPFee, (key, uint24(c.p[0]))));
            }
            _snap(r, key);
            if (c.kind == 1) {
                _call(r, address(PM), abi.encodeCall(IPM.donate, (key, c.p[0], c.p[1], "")));
            } else {
                _call(r, address(PM), abi.encodeCall(IPM.swap, (key, SP(c.zfo, c.amt, c.lim), "")));
            }
            _snap(r, key);
            _settle(c.t0);
            _settle(c.t1);
            _balances(r, c.t0, c.t1);
        } else if (c.kind == 2) {
            PM.sync(c.t0);
            ITok(c.t0).transfer(address(PM), c.p[0]);
            _call(r, address(PM), abi.encodeCall(IPM.settle, ()));
            _push(r, uint256(_delta(address(this), c.t0)));
            _call(r, address(PM), abi.encodeCall(IPM.clear, (c.t0, c.p[1])));
            _push(r, uint256(_delta(address(this), c.t0)));
            _settle(c.t0);
            _balances(r, c.t0, c.t1);
        } else if (c.kind == 3) {
            PM.sync(c.t0);
            ITok(c.t0).transfer(address(PM), c.p[0]);
            _call(r, address(PM), abi.encodeCall(IPM.settleFor, (S)));
            _push(r, uint256(_delta(address(this), c.t0)));
            _push(r, uint256(_delta(S, c.t0)));
            _call(r, S, abi.encodeCall(Driver.exec, (address(PM), abi.encodeCall(IPM.take, (c.t0, S, c.p[0])))));
            _push(r, uint256(_delta(address(this), c.t0)));
            _push(r, uint256(_delta(S, c.t0)));
            _balances(r, c.t0, c.t1);
            _push(r, ITok(c.t0).balanceOf(S));
        } else if (c.kind == 4) {
            _erc6909(r, c);
        } else if (c.kind == 7) {
            _raw(r, c, key);
        }
        uint256[] memory w = r.w;
        uint256 n = r.n;
        assembly {
            mstore(w, n)
        }
        return abi.encode(w);
    }

    /// p = [mint0, mint1, settle flag, ncalls, then per call: length in bytes, words...]. mint0 and mint1 are minted
    /// straight to the PoolManager without sync, as balance that backs pool state written by override.
    function _raw(Rec memory r, C memory c, PoolKey memory key) internal {
        if (c.p[0] > 0) ITok(c.t0).transfer(address(PM), c.p[0]);
        if (c.p[1] > 0) ITok(c.t1).transfer(address(PM), c.p[1]);
        uint256 k = 4;
        for (uint256 j = 0; j < c.p[3]; j++) {
            uint256 len = c.p[k++];
            bytes memory data = new bytes(len);
            for (uint256 q = 0; q < (len + 31) / 32; q++) {
                uint256 v = c.p[k++];
                assembly {
                    mstore(add(add(data, 32), mul(q, 32)), v)
                }
            }
            _call(r, address(PM), data);
        }
        _snap(r, key);
        if (c.p[2] == 1) {
            _settle(c.t0);
            _settle(c.t1);
        }
        _balances(r, c.t0, c.t1);
    }

    /// Calls made while the PoolManager is locked (no unlock around them).
    function outside(bytes[] calldata calls) external returns (bytes[] memory out) {
        out = new bytes[](calls.length);
        for (uint256 i = 0; i < calls.length; i++) {
            (bool ok, bytes memory ret) = address(PM).call(calls[i]);
            out[i] = abi.encode(ok, ret);
        }
    }

    function _erc6909(Rec memory r, C memory c) internal {
        uint256 id = uint256(uint160(c.t0));
        uint256 a = c.p[0];
        _pay(c.t0, a);
        _call(r, address(PM), abi.encodeCall(IPM.mint, (address(this), id, a)));
        _call(r, address(PM), abi.encodeCall(IPM.transfer, (B, id, c.p[1])));
        _call(r, address(PM), abi.encodeCall(IPM.transfer, (B, id, a))); // more than the balance left
        _call(r, address(PM), abi.encodeCall(IPM.approve, (S, id, c.p[2])));
        _call(r, S, abi.encodeCall(Driver.exec, (address(PM), abi.encodeCall(IPM.transferFrom, (address(this), R, id, c.p[3])))));
        _push(r, PM.allowance(address(this), S, id));
        _call(r, S, abi.encodeCall(Driver.exec, (address(PM), abi.encodeCall(IPM.transferFrom, (address(this), R, id, c.p[2])))));
        _call(r, address(PM), abi.encodeCall(IPM.approve, (S, id, type(uint256).max)));
        _call(r, S, abi.encodeCall(Driver.exec, (address(PM), abi.encodeCall(IPM.transferFrom, (address(this), R, id, c.p[3])))));
        _push(r, PM.allowance(address(this), S, id));
        _call(r, address(PM), abi.encodeCall(IPM.approve, (S, id, 0)));
        _call(r, address(PM), abi.encodeCall(IPM.setOperator, (S, true)));
        _call(r, S, abi.encodeCall(Driver.exec, (address(PM), abi.encodeCall(IPM.transferFrom, (address(this), R, id, c.p[3])))));
        _push(r, PM.allowance(address(this), S, id));
        _call(r, S, abi.encodeCall(Driver.exec, (address(PM), abi.encodeCall(IPM.burn, (address(this), id, c.p[4])))));
        _push(r, uint256(_delta(S, c.t0)));
        _call(r, S, abi.encodeCall(Driver.exec, (address(PM), abi.encodeCall(IPM.take, (c.t0, S, c.p[4])))));
        _call(r, address(PM), abi.encodeCall(IPM.setOperator, (S, false)));
        _call(r, address(PM), abi.encodeCall(IPM.approve, (S, id, c.p[5])));
        _call(r, S, abi.encodeCall(Driver.exec, (address(PM), abi.encodeCall(IPM.burn, (address(this), id, c.p[5])))));
        _push(r, PM.allowance(address(this), S, id));
        _call(r, S, abi.encodeCall(Driver.exec, (address(PM), abi.encodeCall(IPM.take, (c.t0, S, c.p[5])))));
        _call(r, S, abi.encodeCall(Driver.exec, (address(PM), abi.encodeCall(IPM.burn, (address(this), id, 1)))));
        _call(r, S, abi.encodeCall(Driver.exec, (address(PM), abi.encodeCall(IPM.transferFrom, (address(this), R, id, 1)))));
        uint256 own = PM.balanceOf(address(this), id) / 2;
        _call(r, address(PM), abi.encodeCall(IPM.burn, (address(this), id, own)));
        _settle(c.t0);
        _push(r, PM.balanceOf(address(this), id));
        _push(r, PM.balanceOf(B, id));
        _push(r, PM.balanceOf(R, id));
        _push(r, PM.balanceOf(S, id));
        _push(r, PM.isOperator(address(this), S) ? 1 : 0);
        _push(r, uint256(_delta(address(this), c.t0)));
        _push(r, uint256(_delta(S, c.t0)));
        _balances(r, c.t0, c.t1);
        _push(r, ITok(c.t0).balanceOf(S));
    }
}
