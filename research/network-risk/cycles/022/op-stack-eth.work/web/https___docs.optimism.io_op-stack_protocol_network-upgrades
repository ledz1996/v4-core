ile contract upgrades ship as\n`,_jsx(_components.a,{href:`/releases/op-contracts`,children:`op-contracts releases`}),` and are executed on each\nchain’s L1 contracts after governance approval. Contract-only upgrades have no\nactivation timestamp, so they do not get hardfork registry pages — their\npermanent record is the op-contracts release history and the operator notice.`]}),`\n`,_jsxs(Table,{children:[_jsx(_components.thead,{children:_jsxs(_components.tr,{children:[_jsx(_components.th,{children:`Upgrade`}),_jsx(_components.th,{children:`What it shipped`}),_jsx(_components.th,{children:`Operator notice`}),_jsx(_components.th,{children:`op-contracts release`})]})}),_jsxs(_components.tbody,{children:[_jsxs(_components.tr,{children:[_jsx(_components.td,{children:`Upgrade 21`}),_jsxs(_components.td,{children:[_jsx(_components.code,{children:`ETHLockbox`}),` as the custody and pause identifier for every chain, and the L1 contract changes for interop`]}),_jsx(_components.td,{children:_jsx(_components.a,{href:`/notices/archive/upgrade-21`,children:`Notice`})}),_jsx(_components.td,{\"data-numeric\":`true`,children:_jsx(_components.a,{href:`/releases/op-contracts`,children:_jsx(_components.code,{children:`v9.0.0`})})})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{children:`Upgrade 20`}),_jsxs(_components.td,{children:[`Super Root Dispute Games (`,_jsx(_components.code,{children:`SUPER_PERMISSIONED`}),`, `,_jsx(_components.code,{children:`SUPER_CANNON_KONA`}),`) and `,_jsx(_components.code,{children:`SystemConfig`}),` interface cleanup`]}),_jsx(_components.td,{children:_jsx(_components.a,{href:`/notices/archive/upgrade-20`,children:`Notice`})}),_jsx(_components.td,{\"data-numeric\":`true`,children:_jsx(_components.a,{href:`/releases/op-contracts`,children:_jsx(_components.code,{children:`v8.0.0`})})})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{children:`Upgrade 18`}),_jsx(_components.td,{children:`Cannon + Kona game type, Custom Gas Token v2, creat