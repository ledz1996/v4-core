# raw downloads of the agents stay on the machine that ran the cycle; scripts and results are kept
cycles/*/*.work/raw/
__pycache__/
# compiler outputs, downloaded toolchain sources, third-party crates and proof program images
cycles/*/*.work/*/build/
cycles/*/*.work/*/rustsrc/
cycles/*/*.work/*/prestate/
cycles/*/*.work/*/crates/
cycles/*/*.work/*/llvm/
cycles/*/*.work/*/dl/
cycles/*/*.work/svbuild/
cycles/*/*.work/**/cargohome/
cycles/*/*.work/**/target/
cycles/*/*.work/**/.git/
